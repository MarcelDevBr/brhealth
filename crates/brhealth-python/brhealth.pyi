class Engine:
    def __init__(self) -> None: ...
    def version(self) -> str: ...
    def source_count(self) -> int: ...
    def list_sources(self) -> List[str]: ...
    def validate_biological_consistency(self, icd10: str, sex: str, age_years: int) -> bool: ...
    def fetch(
        self,
        source_id: str,
        jurisdiction: Optional[str] = None,
        year: int = 2024,
        month: Optional[int] = None,
        harmonize_ibge: bool = True,
        assign_h3: Optional[int] = None,
        enrich_csap: bool = False,
        extra_filters: Optional[Dict[str, str]] = None,
    ) -> RecordBatchWrapper: ...
    @property
    def hospital_morbidity(self) -> HospitalMorbidityAccessor: ...
    @property
    def vital_statistics(self) -> VitalStatisticsAccessor: ...
    @property
    def notifications(self) -> NotificationsAccessor: ...
    @property
    def global_climate(self) -> GlobalClimateAccessor: ...
    @property
    def demographics(self) -> DemographicsAccessor: ...
    @property
    def ambulatory(self) -> AmbulatoryAccessor: ...
    @property
    def environmental(self) -> EnvironmentalAccessor: ...
    @property
    def social(self) -> SocialAccessor: ...
    @property
    def cache(self) -> CacheManager: ...

class CacheManager:
    def clear(self, source_id: Optional[str] = None) -> int: ...
    def clear_older_than(self, days: Optional[int] = None, cutoff_date: Optional[str] = None) -> int: ...
    def status(self, source_id: Optional[str] = None) -> Dict[str, Any]: ...
