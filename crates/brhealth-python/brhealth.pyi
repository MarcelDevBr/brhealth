# Ingestão Top-Level
def fetch(
    source_id: str,
    jurisdiction: Optional[str] = None,
    year: int = 2024,
    month: Optional[int] = None,
    harmonize_ibge: bool = True,
    assign_h3: Optional[int] = None,
    enrich_csap: bool = False,
    extra_filters: Optional[Dict[str, str]] = None,
) -> RecordBatchWrapper: ...

class RecordBatchWrapper:
    @property
    def num_rows(self) -> int: ...
    @property
    def num_columns(self) -> int: ...
    @property
    def shape(self) -> Tuple[int, int]: ...
    @property
    def columns(self) -> List[str]: ...
    @property
    def schema(self) -> Dict[str, str]: ...
    @property
    def manifest_json(self) -> Optional[str]: ...
    def column_names(self) -> List[str]: ...
    def head(self, n: Optional[int] = 5) -> RecordBatchWrapper: ...
    def tail(self, n: Optional[int] = 5) -> RecordBatchWrapper: ...
    def to_pandas(self) -> Any: ...
    def to_polars(self) -> Any: ...
    def to_pyarrow(self) -> Any: ...
    def to_dict(self) -> Dict[str, List[Any]]: ...
    def to_pydict(self) -> Dict[str, List[Any]]: ...
    def export_fair_manifest(self, path: str) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, key: Union[str, int, slice]) -> Any: ...

